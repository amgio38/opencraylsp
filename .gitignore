.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.history/

# Operating system files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

# Local tool and AI-agent state (per developer, not part of the project)
.claude/
.cray/
.cursor/
.opencode/
.codex/
.aider*
CLAUDE.local.md

